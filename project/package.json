{
  "name": "carrefour-qa",
  "version": "1.0.0",
  "description": "Mobile E2E automation — WDIO Native Demo App",
  "main": "index.js",
  "scripts": {
    "appium:start": "bash scripts/start-appium.sh",
    "mcp:server": "bash scripts/wdio-mcp.sh",
    "test:android": "PLATFORM=android wdio run config/wdio.conf.ts",
    "test:ios": "PLATFORM=ios wdio run config/wdio.conf.ts",
    "test:android:bs": "PLATFORM=android TARGET=browserstack wdio run config/wdio.conf.ts",
    "test:ios:bs": "PLATFORM=ios TARGET=browserstack wdio run config/wdio.conf.ts",
    "test:android:hybrid": "npm run test:android && npm run test:android:bs",
    "test:ios:hybrid": "npm run test:ios && npm run test:ios:bs",
    "test:e2e": "npm run test:android",
    "test:api": "wdio run config/wdio.api.conf.ts",
    "report": "allure open tests/results/$(date +%Y-%m-%d)/allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/browserstack-service": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.0",
    "allure-commandline": "^2.43.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.0",
    "appium-xcuitest-driver": "^9.2.0",
    "expect-webdriverio": "^5.6.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "webdriverio": "^9.30.1"
  }
}
