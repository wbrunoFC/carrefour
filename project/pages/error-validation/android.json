{
  "page": "error-validation",
  "platform": "android",
  "elements": {
    "emailErrorMessage": {
      "id": "EL022",
      "name": "Erro email inválido",
      "type": "text",
      "selector": {
        "strategy": "androidUiAutomator",
        "value": "new UiSelector().textContains(\"Please enter a valid email address\")"
      }
    },
    "passwordErrorMessage": {
      "id": "EL023",
      "name": "Erro senha curta",
      "type": "text",
      "selector": {
        "strategy": "androidUiAutomator",
        "value": "new UiSelector().textContains(\"Please enter at least 8 characters\")"
      }
    },
    "requiredFieldsErrorMessage": {
      "id": "EL024",
      "name": "Erro campos obrigatórios",
      "type": "text",
      "selector": {
        "strategy": "androidUiAutomator",
        "value": "new UiSelector().textContains(\"Please enter\")"
      }
    },
    "errorAlert": {
      "id": "EL025",
      "name": "Alerta erro genérico",
      "type": "alert",
      "selector": {
        "strategy": "androidUiAutomator",
        "value": "new UiSelector().textContains(\"Please enter\")"
      }
    },
    "confirmPasswordErrorMessage": {
      "id": "EL026",
      "name": "Erro confirmação divergente",
      "type": "text",
      "selector": {
        "strategy": "androidUiAutomator",
        "value": "new UiSelector().textContains(\"Please enter the same password\")"
      }
    }
  }
}
